# DrugSim prediction API image (src/drugsim_predict) -- the FastAPI service
# serving the two validated ADMET models (hERG inhibition, CYP3A4 inhibition).
#
# Phase 8 addition: Dockerfile.app (the existing image in this directory)
# builds the CLI/ETL tool (entrypoint "drugsim"), not this service.
#
# Render deployment fix (this revision): the previous version of this file
# required a poetry.lock that has never existed in this repository (see
# git history / docs/phase8's "Known limitations") -- the build would fail
# at `COPY pyproject.toml poetry.lock` on a clean checkout. Poetry is
# dropped entirely; the builder stage installs via pip. The internal
# packages under src/ (drugsim_core, drugsim_chem, drugsim_features,
# drugsim_predict) are made importable via PYTHONPATH rather than an
# editable pip install, matching how every test run and local server start
# in this project's history has already been invoked.
#
# Render deployment fix (this revision, take two): installing from the
# project-wide requirements-lock.txt (which lists dependencies for the
# whole platform -- ETL, database migrations, object storage -- not just
# this one service) pulled in pyarrow==12.0.1, which has no prebuilt wheel
# for Render's build environment and fails compiling from source. pyarrow
# is not even imported anywhere in this service's code. Now installs from
# requirements-predict-api.txt instead: a minimal, verified list (derived
# by grepping every actual import across src/drugsim_predict, drugsim_core,
# drugsim_chem, drugsim_features, then confirmed by running a real
# end-to-end prediction in a venv containing ONLY those packages) -- see
# that file's own header for the full list and reasoning.
#
# MODEL ARTIFACTS: models/**/*.joblib and models/**/artifact/ are
# gitignored on purpose (large trained-model binaries, not source) and are
# NOT present in a fresh checkout. This build fetches them from a GitHub
# Release via scripts/fetch_model_artifacts.sh, pointed at by the
# MODEL_RELEASE_URL_BASE ARG in the builder stage below.
#
# Render deployment fix (this revision): Render's Blueprint format (render.yaml)
# has NO way to pass a Docker build ARG -- there is no dockerBuildArgs field,
# despite an earlier revision of render.yaml assuming one (confirmed against
# Render's own Blueprint spec: only dockerCommand/dockerfilePath/dockerContext/
# registryCredential are supported for a docker-runtime service). So that
# ARG's default value is the real, load-bearing value for a Render deploy of
# this exact repo, not a placeholder -- change it there (and only there) if
# the GitHub Release this points to ever moves. A local `docker build` can
# still override it with `--build-arg MODEL_RELEASE_URL_BASE=...` for testing
# against a different release without editing this file.

# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential curl ca-certificates; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-predict-api.txt ./
RUN pip install --no-cache-dir -r requirements-predict-api.txt

COPY src/ ./src/
COPY scripts/ ./scripts/
# Explicit allowlist, not `COPY models/registry/ ./models/registry/` --
# models/registry/ also holds cyp2d6_activity_v1.json and
# bbb_permeability_v1.json (psychiatric-pipeline endpoints, deliberately
# EXPERIMENTAL and offline-only, per docs/psychiatric-pipeline/
# api-integration.md's explicit decision not to go live yet). Their
# artifacts are never fetched into this image on purpose, so copying the
# whole directory makes verify_model_integrity.py below correctly refuse
# to build (a registered endpoint with no artifact). Add a new registry
# file to this list only when its artifact is also added to
# scripts/fetch_model_artifacts.sh -- registering a model for the generic
# architecture and deploying it live are separate decisions.
COPY models/registry/herg_inhibition_v1.json ./models/registry/herg_inhibition_v1.json
COPY models/registry/cyp3a4_inhibition_v1.json ./models/registry/cyp3a4_inhibition_v1.json

# Fetches the eight large artifact files this build does not otherwise have
# (see header). ARG, not ENV: the URL is a build-time input, not something
# that needs to persist into the running container. Defaulted to this repo's
# real Release (Render's Blueprint format cannot pass build ARGs -- see
# header) -- override with `--build-arg MODEL_RELEASE_URL_BASE=...` for a
# local build against a different release.
ARG MODEL_RELEASE_URL_BASE=https://github.com/cuberthinks/drugsim/releases/download/models-v1
RUN test -n "$MODEL_RELEASE_URL_BASE" || (echo "MODEL_RELEASE_URL_BASE build arg is required -- see this Dockerfile's header." >&2 && exit 1)
RUN MODEL_RELEASE_URL_BASE="$MODEL_RELEASE_URL_BASE" bash scripts/fetch_model_artifacts.sh

# Copies the small (non-gitignored) per-endpoint manifest files that live
# alongside (not inside) each artifact/ directory.
COPY models/admet/herg_inhibition/inference_support_manifest.json ./models/admet/herg_inhibition/inference_support_manifest.json
COPY models/admet/cyp3a4_inhibition/inference_support_manifest.json ./models/admet/cyp3a4_inhibition/inference_support_manifest.json

# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

# libgomp is required by RDKit's compiled extensions (same as Dockerfile.app).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgomp1 curl; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 1000 drugsim; \
    useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin drugsim

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder --chown=drugsim:drugsim /app/src /app/src
COPY --from=builder --chown=drugsim:drugsim /app/scripts /app/scripts
COPY --from=builder --chown=drugsim:drugsim /app/models /app/models

# The prediction audit log (SQLite) lives here at runtime -- writable by
# the non-root user, and expected to be a mounted/persistent disk in
# production so it survives container replacement (see docs/phase8
# "Backups"; on Render, attach a Persistent Disk at this mount path).
RUN mkdir -p /app/var && chown drugsim:drugsim /app/var

USER drugsim

# Fails the build immediately if ANY registered endpoint's artifact is
# missing or its checksum does not match the registry -- never ships an
# image that would only discover this at first request. Reuses the exact
# same multi-endpoint check `scripts/verify_model_integrity.py` runs as an
# explicit CI/deploy gate (Phase 10 fix: this previously checked only the
# hERG default, silently skipping any other registered endpoint).
RUN python scripts/verify_model_integrity.py

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "drugsim_predict.api:app", "--host", "0.0.0.0", "--port", "8000"]
