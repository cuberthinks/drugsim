# DrugSim frontend image: the Phase 6 React app, built for production and
# served by Caddy, which also reverse-proxies /api/* to the prediction
# service and terminates HTTPS.
#
# One container does static serving + reverse proxy + TLS -- deliberately,
# per Phase 8's "do not introduce unnecessary infrastructure": a separate
# nginx-for-static plus a separate TLS terminator would be two more moving
# parts for no benefit at this scale. Caddy does all three well and gets
# automatic HTTPS (via Let's Encrypt) for free once a real domain is
# configured -- see deployment/caddy/Caddyfile.
#
# The frontend's own API client already defaults to a same-origin relative
# "/api" base URL (frontend/src/api/client.ts, unchanged since Phase 6),
# so no build-time VITE_API_BASE_URL override is needed for this topology
# -- the browser calls the same origin it loaded the page from, and Caddy
# is what routes /api/* to the backend container. No localhost, and no
# other environment's URL, is ever baked into this build.

# --------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# --------------------------------------------------------------------------
FROM caddy:2-alpine AS runtime

COPY --from=builder /build/dist /srv
COPY deployment/caddy/Caddyfile /etc/caddy/Caddyfile

# Caddy validates its own config; fails the build if the Caddyfile is broken.
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O- http://localhost:80 >/dev/null || exit 1
